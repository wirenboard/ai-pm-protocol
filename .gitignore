# Local-only files
*.swp
.DS_Store

# Reviewer local traces (not committed)
.reviews/

# Claude Code worktree + throwaway scratch dirs
.claude/worktrees/
.claude/tmp/
.ai-dev/tmp/
_scratch/
scratchpad/

# Session state — local-only pointer, never committed
.ai-dev/state/

# Dogfood-deployed quality runner — a build artifact, never a committed duplicate of
# src/quality/run.mjs. The downstream installer deploys to .ai-dev/quality/run.mjs;
# the dogfood reinstall now mirrors that path so both worlds use the same string.
.ai-dev/quality/

# Self-report transients — raw pre-sweep failure context, never committed
.ai-dev/feedback/
.ai-dev/worktrees/

# Installer test temp targets (created inside the repo root by the boundary deny;
# leaked dirs must never pollute git status or the eslint scandir walk)
.tmp-install*

# Node dependencies (the linters; package-lock.json IS committed)
node_modules/

# Personal overrides — per-machine values never committed, never break a teammate
.ai-dev/config.local.json
.ai-dev/model-routes.local.json
